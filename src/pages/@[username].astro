---
export const prerender = false;

import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

/**
 * SEMENTARA — mock data
 * nanti fetch dari:
 * - Worker API
 * - Durable Object
 */
const profile = {
  username: Astro.params.username,
  displayName: "READTalk Member",
  about: "This is a public identity card on READTalk.",
  avatar: "/favicon.svg",
  links: [
    { label: "Website", url: "https://readtalk.workers.dev" },
    { label: "Twitter", url: "https://twitter.com" },
    { label: "GitHub", url: "https://github.com" }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`@${profile.username} on READTalk`}
      description={profile.about}
    />
  </head>

  <body>
    <Header />

    <main>
      <img
        src={profile.avatar}
        alt="Avatar"
        width="96"
        height="96"
      />

      <h1>{profile.displayName}</h1>
      <p>@{profile.username}</p>

      <p>{profile.about}</p>

      <ul>
        {profile.links.map((link) => (
          <li>
            <a href={link.url} rel="noopener noreferrer">
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <p>
        <a href="https://readtalk.workers.dev">
          Open in READTalk
        </a>
      </p>
    </main>

    <Footer />
  </body>
</html>
