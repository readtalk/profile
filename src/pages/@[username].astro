---
export const prerender = false;

import { getProfile } from '../lib/profile.js'; // ambil data dari D1 / KV
const { username, links } = await getProfile(Astro.params.username);
---

<html lang="en">
  <head>
    <title>{username} | READTalk</title>
  </head>
  <body>
    <main>
      <h1>{username}</h1>
      <ul>
        {links.map(link => (
          <li><a href={link.url} target="_blank">{link.label}</a></li>
        ))}
      </ul>
    </main>
  </body>
</html>
