---
import BaseHead from '../components/BaseHead.astro';

const username = 'alice'; // nanti diganti dinamis dari route params
const userData = await PROFILE_KV.get(username, 'json') || {
  displayName: 'Alice',
  bio: 'Private by design.',
  links: [
    { label: 'Website', url: 'https://alice.example.com' },
    { label: 'Blog', url: 'https://blog.alice.example.com' },
  ],
};
---

<html lang="en">
  <head>
    <BaseHead title={`@${username} — READTalk`} description={userData.bio} />
  </head>
  <body>
    <main class="container">
      <section class="profile-card">
        <h1>{userData.displayName}</h1>
        <p class="bio">{userData.bio}</p>

        <ul class="links">
          {userData.links.map((link) => (
            <li>
              <a href={link.url} target="_blank" rel="noopener">{link.label}</a>
            </li>
          ))}
        </ul>

        <p class="cta-download">
          <a href="/download">Download READTalk</a>
        </p>
      </section>
    </main>
  </body>
</html>

<style>
.container {
  max-width: 480px;
  margin: 2rem auto;
  padding: 0 1rem;
  text-align: center;
  font-family: system-ui, sans-serif;
}

.profile-card h1 {
  font-size: 1.75rem;
  margin-bottom: 0.5rem;
}

.bio {
  opacity: 0.7;
  margin-bottom: 1.5rem;
}

.links {
  list-style: none;
  padding: 0;
  display: grid;
  gap: 0.75rem;
}

.links a {
  display: block;
  padding: 0.75rem 1rem;
  background: #f0f0f0;
  border-radius: 999px;
  text-decoration: none;
  color: inherit;
}

.cta-download a {
  display: inline-block;
  margin-top: 2rem;
  padding: 0.75rem 1.5rem;
  background: #007aff;
  color: white;
  border-radius: 999px;
  text-decoration: none;
}
</style>
