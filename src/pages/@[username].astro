---
export const prerender = false;
/**
 * READTalk Public Profile
 * Route: /@username
 * Role:
 * - Public identity card
 * - Read-only
 * - Runtime data from Durable Object
 */

import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const { username } = Astro.params;

/**
 * TEMP snapshot
 * nanti fetch dari Worker / DO
 */
const profile = {
  username,
  displayName: username,
  avatar: "/avatar-placeholder.png",
  about: "This identity lives inside READTalk.",
  links: [
    { label: "Website", url: "https://example.com" },
    { label: "X / Twitter", url: "https://x.com/" },
    { label: "Instagram", url: "https://instagram.com/" },
    { label: "GitHub", url: "https://github.com/" },
    { label: "LinkedIn", url: "https://linkedin.com/" }
  ]
};
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead
      title={`@${profile.username} — READTalk`}
      description={`Public identity card of @${profile.username}`}
    />
  </head>

  <body>
    <Header />

    <main class="container">
      <section class="profile">
        <img src={profile.avatar} class="avatar" />
        <h1>{profile.displayName}</h1>
        <p class="username">@{profile.username}</p>
        <p class="about">{profile.about}</p>
      </section>

      <section class="links">
        <ul>
          {profile.links.map(link => (
            <li>
              <a href={link.url} target="_blank" rel="noopener">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="cta">
        <p>To interact, open READTalk.</p>
        <a href="/download" class="cta-button">Open READTalk</a>
      </section>
    </main>

    <Footer />
  </body>
</html>
