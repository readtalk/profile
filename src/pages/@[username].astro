---

import { getProfileData } from '../lib/profileData.js';

export const prerender = false; // server-rendered karena dynamic route

export async function getStaticPaths() { // Kosongkan atau bisa return empty array karena kita pakai server-side return []; }

const { username } = Astro.params; const profile = await getProfileData(username);

<section class="profile-page">
  <h1>@{username}</h1>
  {profile ? (
    <div class="profile-info">
      <p>Name: {profile.name}</p>
      <p>Bio: {profile.bio}</p>
      <p>Links:</p>
      <ul>
        {profile.links.map(link => (
          <li><a href={link.url} target="_blank" rel="noopener">{link.title}</a></li>
        ))}
      </ul>
    </div>
  ) : (
    <p>Profile not found.</p>
  )}
</section><style>
  .profile-page {
    padding: 1rem;
    max-width: 600px;
    margin: auto;
  }
  .profile-info ul {
    list-style: none;
    padding: 0;
  }
  .profile-info li {
    margin-bottom: 0.5rem;
  }
</style>
