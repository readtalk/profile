---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={SITE_TITLE}
      description="READTalk is a private-first messenger. Public profiles are identity cards, not social feeds."
    />
  </head>

  <body>
    <Header />

    <main>
      <h1>READTalk</h1>

      <p>
        READTalk is a private-first messenger.
        Public profiles exist only as identity cards — not timelines.
      </p>

      <p>
        If you found a READTalk profile from Google,
        you are seeing a public identity stub.
        Conversations and social activity happen inside the app.
      </p>

      <p>
        Want to interact?
        You need a READTalk account.
      </p>

      <p>
        <a href="https://readtalk.workers.dev">
          Open READTalk
        </a>
      </p>
    </main>

    <Footer />
  </body>
</html>
