---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>

  <body>
    <Header />

    <main>
      <h1>READTalk</h1>

      <p>Chat DNA. Identity lives in the room.</p>

      <form>
        <label>
          @
          <input
            type="search"
            placeholder="username"
            disabled
          />
        </label>
        <button disabled>View</button>
      </form>

      <p>Only public identity cards are visible.</p>

      <p>
        To interact, chat, or discover members,
        you must be inside READTalk.
      </p>

      <p>
        <a href="/download">Download READTalk</a>
      </p>
    </main>

    <Footer />
  </body>
</html>
