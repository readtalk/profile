    }
  ],

  "kv_namespaces": [
    {
      "binding": "PROFILE_KV",
      "id": "2717482567924ee2a095f3548a07c520"
    }
  ],

  "observability": {
    "enabled": true
  },

  "upload_source_maps": true
}
